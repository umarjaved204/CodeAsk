# Copy to .env and fill in. Never commit .env.
# Prod: a separate .env.prod (gitignored) with DATABASE_URL and DATABASE_OWNER_URL only, read
# ONLY by an explicit --prod flag (admin, ingest); it never falls back to these dev values.

# Neon: Dashboard > Connect > connection string (keep ?sslmode=require)
# The API's role, pooled. Used by the API and every admin command except setup and grants.
DATABASE_URL=
# The owner role, DIRECT (Connect > untick "Connection pooling"). Only for admin setup and
# admin grants, and the db tests of the grants. Local only: never set this on Render.
DATABASE_OWNER_URL=

# Voyage: dashboard.voyageai.com > API Keys
VOYAGE_API_KEY=

# Groq: console.groq.com > API Keys
GROQ_API_KEY=

# Gemini: aistudio.google.com > Get API key (offline eval only)
GEMINI_API_KEY=

# Salt for hashing visitor IPs (per-IP limits). Required, at least 16 random characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never logged. Rotating it is safe: it only resets the in-memory per-visitor counts.
IP_SALT=

# Optional: the cold-start constants in whole seconds (empty = the code's values). Startup
# refuses anything outside 0 < PROJECTED_SERVICE_SEED_S <= MIN_TIME_TO_START_S <= 30 and logs
# the values it uses. Set from measurements by the PLAN.md Q61 rule.
PROJECTED_SERVICE_SEED_S=
MIN_TIME_TO_START_S=
