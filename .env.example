# Copy to .env and fill in. Never commit .env.

# Neon: Dashboard > Connect > connection string (keep ?sslmode=require)
# The API's role, pooled. Used by the API and every admin command except setup and grants.
DATABASE_URL=
# The owner role, DIRECT (Connect > untick "Connection pooling"). Only for admin setup and
# admin grants, and the db tests of the grants. Local only: never set this on Render.
DATABASE_OWNER_URL=

# Voyage: dashboard.voyageai.com > API Keys
VOYAGE_API_KEY=

# Groq: console.groq.com > API Keys
GROQ_API_KEY=

# Gemini: aistudio.google.com > Get API key (offline eval only)
GEMINI_API_KEY=

# Salt for hashing visitor IPs (per-IP limits). Required, at least 16 random characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never logged. Rotating it is safe: it only resets the in-memory per-visitor counts.
IP_SALT=
