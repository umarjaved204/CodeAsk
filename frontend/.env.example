# Frontend settings (PLAN.md Q77). Local dev puts these in frontend/.env.local; Vercel sets them
# per project (Production scope). All are read at build time, so a change needs a redeploy.

# Required in production builds: bare origins, https (no path, no trailing slash).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=

# Unset = the safe default. A misspelled value fails the build.
# SITE_INDEXABLE: true | false (default false: X-Robots-Tag noindex)
SITE_INDEXABLE=
# CSP_MODE: report-only | enforce (default report-only)
CSP_MODE=
