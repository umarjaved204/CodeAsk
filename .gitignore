# Secrets: never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
# The browser tests' own build (playwright.e2e.config.ts)
.next-e2e/
out/
# Design review screenshots (regenerated by the review script, slice 3)
frontend/design-review/
# Regenerated by Next.js on every build
frontend/next-env.d.ts
# TypeScript's incremental cache (tsc --noEmit with "incremental": true)
*.tsbuildinfo
# Playwright output
frontend/test-results/
frontend/playwright-report/

# Cloned repos used for ingestion
repos/
# Chunk snapshots (regenerate with spike/chunk_snapshot.py; hundreds of KB each)
spike/*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
